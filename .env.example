# ════════════════════════════════════════════════════════════════
# RénoBoost Leads — Variables d'environnement
# ════════════════════════════════════════════════════════════════
# 1. Copier ce fichier en `.env` : cp .env.example .env
# 2. Remplir les clés ci-dessous
# 3. NE JAMAIS commiter `.env` (déjà dans .gitignore)
# ════════════════════════════════════════════════════════════════

# ─── ÉTAGE 1 : Google Places API (New) ────────────────────────────
# Obtenue sur console.cloud.google.com → Identifiants
GOOGLE_PLACES_API_KEY=

# ─── ÉTAGE 2 : Pappers API (à activer plus tard) ──────────────────
# Obtenue sur pappers.fr/api → ton compte → API
# Plans: starter (39€/mois, 100 req) | pro (99€/mois, 1000 req)
PAPPERS_API_KEY=
PAPPERS_PLAN=starter

# ─── ÉTAGE 3.5 : Dropcontact API (enrichissement contacts vérifiés) ──
# Obtenue sur dropcontact.com → Mon compte → API
# Plan starter : ~49€/mois pour 100 crédits (1 crédit = 1 lead enrichi).
# Sans clé : étage 3.5 désactivé, le pipeline saute directement à L4.
# Activer en mettant `enable_stage_3_5_enrichment: true` dans le YAML.
DROPCONTACT_API_KEY=

# ─── ENRICHISSEMENT : Societeinfo API (firmographie FR — optionnel) ──
# Obtenue sur societeinfo.com → compte → API. Meilleur taux de match SIREN +
# firmographie que le L2 gratuit (data.gouv). Utilisée par la commande
# `enrich-societeinfo` (autonome). Sans clé : la commande tourne en dry-run.
SOCIETEINFO_API_KEY=

# ─── ÉTAGE 4 : Anthropic Claude API ───────────────────────────────
# Obtenue sur console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modèle par défaut (peut être surchargé par claude_scoring.modele dans le YAML)
#   claude-haiku-4-5  → ~0.005 €/lead, par défaut
#   claude-sonnet-4-6 → ~0.02 €/lead, qualité supérieure
CLAUDE_MODEL=claude-haiku-4-5

# ─── INSTANTLY — Cold mailing Phase B (optionnel) ─────────────────
# Tant que la clé n'est pas renseignée OU que INSTANTLY_DRY_RUN=true,
# tous les appels Instantly sont simulés (utile pour dev sans abo actif).
INSTANTLY_API_KEY=
INSTANTLY_BASE_URL=https://api.instantly.ai/api/v2
INSTANTLY_DRY_RUN=true             # bascule à false quand l'abo est actif

# ─── PLAFONDS DE SÉCURITÉ (hardcodés côté code aussi) ─────────────
MAX_BUDGET_EUR_PER_RUN=30
MAX_LEADS_PER_RUN=500
MAX_REQUESTS_PER_MINUTE=60

# ─── STORAGE SUPABASE — Persistance des sessions (optionnel) ──────
# Active la persistance des sessions vers un bucket Supabase Storage.
# Sans ces variables, les sessions restent dans data/output/ local.
# Indispensable sur Streamlit Cloud (filesystem éphémère).
#
# 1. Crée un projet Supabase + bucket "sessions" privé.
# 2. Récupère SUPABASE_URL + clé service_role :
#    Dashboard → Project Settings → API → Service role key (PAS anon).
#    NE JAMAIS exposer la service_role côté client/navigateur.
STORAGE_BACKEND=local                # local | supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=sessions

# ─── APP STREAMLIT — Auth simple (optionnel) ──────────────────────
# Si renseigné, l'app Streamlit déployée demande ce mdp avant accès.
# Si vide, l'app est ouverte (mode dev local).
APP_PASSWORD=

# ─── VEILLE — Notification email (Phase C, optionnel) ────────────
# SMTP pour l'envoi du résumé matinal de la veille immatriculations VE.
# Gmail : créer un "mot de passe d'application" sur myaccount.google.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DESTINATAIRES=                # CSV, ex: paul@renoboost.fr,co@renoboost.fr

# ─── LOGGING ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
