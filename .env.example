# ════════════════════════════════════════════════════════════════
# RénoBoost Leads — Variables d'environnement
# ════════════════════════════════════════════════════════════════
# 1. Copier ce fichier en `.env` : cp .env.example .env
# 2. Remplir les clés ci-dessous
# 3. NE JAMAIS commiter `.env` (déjà dans .gitignore)
# ════════════════════════════════════════════════════════════════

# ─── ÉTAGE 1 : Google Places API (New) ────────────────────────────
# Obtenue sur console.cloud.google.com → Identifiants
GOOGLE_PLACES_API_KEY=

# ─── ÉTAGE 2 : Pappers API (à activer plus tard) ──────────────────
# Obtenue sur pappers.fr/api → ton compte → API
# Plans: starter (39€/mois, 100 req) | pro (99€/mois, 1000 req)
PAPPERS_API_KEY=
PAPPERS_PLAN=starter

# ─── ÉTAGE 3 : Dropcontact API (à activer plus tard) ──────────────
# Obtenue sur dropcontact.com → Mon compte → API
DROPCONTACT_API_KEY=

# ─── ÉTAGE 4 : Anthropic Claude API ───────────────────────────────
# Obtenue sur console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modèle par défaut (peut être surchargé par claude_scoring.modele dans le YAML)
#   claude-haiku-4-5  → ~0.005 €/lead, par défaut
#   claude-sonnet-4-6 → ~0.02 €/lead, qualité supérieure
CLAUDE_MODEL=claude-haiku-4-5

# ─── PLAFONDS DE SÉCURITÉ (hardcodés côté code aussi) ─────────────
MAX_BUDGET_EUR_PER_RUN=30
MAX_LEADS_PER_RUN=500
MAX_REQUESTS_PER_MINUTE=60

# ─── VEILLE — Notification email (Phase C, optionnel) ────────────
# SMTP pour l'envoi du résumé matinal de la veille immatriculations VE.
# Gmail : créer un "mot de passe d'application" sur myaccount.google.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DESTINATAIRES=                # CSV, ex: paul@renoboost.fr,co@renoboost.fr

# ─── LOGGING ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
