# .gitattributes - Standardise les line endings
# LF (style Unix) pour tous les fichiers texte du projet
# Auto-detection pour le reste

* text=auto eol=lf

# Code Python toujours en LF
*.py text eol=lf
*.pyi text eol=lf

# Config et data toujours en LF
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Scripts shell toujours en LF
*.sh text eol=lf

# Scripts PowerShell en CRLF (Windows attend CRLF)
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Fichiers binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary
*.sqlite binary
*.db binary
