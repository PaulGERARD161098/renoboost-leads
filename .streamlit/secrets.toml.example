# Template de secrets pour Streamlit Cloud.
#
# Sur Streamlit Cloud :
#   1. Aller dans App settings → Secrets
#   2. Coller le contenu de ce fichier en remplaçant les valeurs
#   3. Sauvegarder — l'app redémarre automatiquement
#
# En local, tu peux soit :
#   - Copier ce fichier en .streamlit/secrets.toml (gitignored)
#   - Ou continuer d'utiliser le .env standard (pris en charge par Settings)

# ─── APIs ────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY = "AIza..."
ANTHROPIC_API_KEY = "sk-ant-api03-..."
DROPCONTACT_API_KEY = ""               # vide = L3.5 désactivé
PAPPERS_API_KEY = ""                   # optionnel

# ─── Plafonds ─────────────────────────────────────────────────────
MAX_BUDGET_EUR_PER_RUN = 30
MAX_LEADS_PER_RUN = 500
MAX_REQUESTS_PER_MINUTE = 60

# ─── Veille — SMTP (optionnel sur Cloud) ─────────────────────────
SMTP_HOST = ""
SMTP_PORT = 587
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_FROM = ""
SMTP_DESTINATAIRES = ""

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL = "INFO"
LOG_FORMAT = "json"
